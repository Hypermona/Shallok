{
  "name": "shallok",
  "version": "0.1.4",
  "description": "AI-Powered, Versioned Localization Tool for AI Coding Agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "shallok": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hypermona/Shallok.git"
  },
  "keywords": [
    "i18n",
    "localization",
    "internationalization",
    "translation",
    "ai-agent",
    "nextjs",
    "react",
    "expo",
    "astro",
    "ast"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-skills.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "ink": "^5.1.0",
    "ora": "^8.2.0",
    "react": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@shallok/core": "workspace:*",
    "@shallok/framework-adapters": "workspace:*",
    "@shallok/translation-providers": "workspace:*",
    "@types/node": "^22.13.8",
    "@types/react": "^18.3.18",
    "tsup": "^9.0.0",
    "typescript": "^5.7.3"
  }
}
